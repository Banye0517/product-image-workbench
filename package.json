{
  "name": "product-image-workbench",
  "version": "1.1.5",
  "private": true,
  "description": "Local product photography selection, composition and batch export workbench",
  "author": "Workbench Studio",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.js",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "check": "eslint src server shared",
    "desktop": "npm run build && electron .",
    "build:mac-cutout": "swiftc -target arm64-apple-macosx14.0 -O -o desktop/bin/cutout desktop/cutout.swift",
    "package:mac": "npm run build && npm run build:mac-cutout && electron-builder --mac zip --arm64"
  },
  "dependencies": {
    "express": "^5.1.0",
    "konva": "^10.0.0",
    "lucide-react": "^0.468.0",
    "onnxruntime-node": "1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "studio.product.workbench",
    "productName": "商品图工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "mac": {
      "target": "zip",
      "category": "public.app-category.graphics-design",
      "identity": null,
      "minimumSystemVersion": "14.0.0",
      "icon": "desktop/icon.icns"
    },
    "extraResources": [
      {
        "from": "desktop/bin/cutout",
        "to": "cutout"
      }
    ]
  }
}
